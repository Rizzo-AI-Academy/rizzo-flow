# Rizzo Flow API in a container — copy to .env and edit; every value has a working default.
#
#   cp .env.example .env
#   make up            # CPU
#   make gpu           # AMD/Intel GPU (Vulkan) — or: make cuda for NVIDIA
#
# There is no commit to pin: the image is built from this checkout. The llama.cpp build and
# the GGUF land in ./data on first start and are reused afterwards.

# --- networking ---------------------------------------------------------------
# Host port. RIZZO_HOST=127.0.0.1 keeps the API private to this machine;
# use 0.0.0.0 only if you really want it exposed on the LAN.
RIZZO_HOST=127.0.0.1
RIZZO_PORT=8017

# --- model --------------------------------------------------------------------
# 4b (default) | 1.7b   — 1.7b downloads 1.1–1.8 GB instead of 2.6–4.4 GB, is ~2x faster
#                         and much less accurate
RIZZO_SIZE=4b
# q8_0 (4.4 GB, default) | q4_k_m (2.6 GB) | bf16 (8.2 GB)
RIZZO_QUANT=q8_0
# flow = the fine-tune for typed decisions (default) | base = original Spark-X2.5
RIZZO_WEIGHTS=flow

# --- runtime ------------------------------------------------------------------
# Both are set by the compose files: cpu/cpu in docker-compose.yml,
# vulkan/auto in docker-compose.gpu.yml, cuda/auto in docker-compose.cuda.yml.
# Uncomment only to force something else.
#RIZZO_RUNTIME=vulkan
#RIZZO_DEVICE=auto

# Context limit in tokens per question (state + question); longer input is rejected.
RIZZO_CTX=8192
# Questions answered in one micro-batch.
RIZZO_BATCH_SIZE=4
# CPU threads (only with RIZZO_RUNTIME=cpu); default = llama.cpp's own choice.
#RIZZO_THREADS=6
# KV cache precision, use when a long RIZZO_CTX does not fit: q8_0 halves it, q4_0 quarters it.
#RIZZO_KV_TYPE=q8_0
# Optional temperature calibration fitted with `rizzo calibrate` (path inside the container,
# for example /data/fit.json after copying it into ./data).
#RIZZO_CALIBRATION=/data/fit.json
# 1 = never fetch runtime and weights (they must already be in ./data).
#RIZZO_SKIP_DOWNLOAD=1

# --- auth ---------------------------------------------------------------------
# Set to enable Bearer auth on the Jev-compatible endpoints (/v1/systemone, /v1/models).
# Leave empty for no auth (the port is loopback-only anyway).
RIZZO_API_KEY=

# --- GPU overlay only ---------------------------------------------------------
# Group used to open /dev/dri/renderD* in docker: the host's render GID
# (getent group render, often 989, 992 or 987). Podman rootless needs nothing: it uses
# `keep-groups`, the default.
#RIZZO_GROUP_ADD=989

# --- optional -----------------------------------------------------------------
# Hugging Face token, only for gated/private repositories (the pinned files are public).
#HF_TOKEN=

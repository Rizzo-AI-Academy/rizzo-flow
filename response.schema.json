    "Statistics": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "stddev": {
          "minimum": 0,
          "title": "Stddev",
          "type": "number"
        },
        "median": {
          "title": "Median",
          "type": "number"
        },
        "anchor_quantiles": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "p10",
              "p90"
            ]
          },
          "title": "Anchor Quantiles",
          "type": "object"
        }
      },
      "required": [
        "mean",
        "stddev",
        "median",
        "anchor_quantiles"
      ],
      "title": "Statistics",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "description": "Seconds and token counts of one request. The two backends count different\npeak-memory figures and the engine's own timings only exist once a request has run,\nso serialization drops whatever is absent instead of emitting nulls.",
      "properties": {
        "inference_seconds": {
          "title": "Inference Seconds",
          "type": "number"
        },
        "prefill_seconds": {
          "title": "Prefill Seconds",
          "type": "number"
        },
        "shared_prefix_tokens": {
          "title": "Shared Prefix Tokens",
          "type": "integer"
        },
        "evaluated_tokens_including_padding": {
          "title": "Evaluated Tokens Including Padding",
          "type": "integer"
        },
        "logical_input_tokens": {
          "title": "Logical Input Tokens",
          "type": "integer"
        },
        "batches": {
          "title": "Batches",
          "type": "integer"
        },
        "generated_tokens": {
          "title": "Generated Tokens",
          "type": "integer"
        },
        "peak_mlx_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Mlx Bytes"
        },
        "peak_device_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Device Bytes"
        },
        "queue_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Seconds"
        },
        "compile_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compile Seconds"
        },
        "total_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Seconds"
        }
      },
      "required": [
        "inference_seconds",
        "prefill_seconds",
        "shared_prefix_tokens",
        "evaluated_tokens_including_padding",
        "logical_input_tokens",
        "batches",
        "generated_tokens"
      ],
      "title": "Timing",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "top_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Top Probability",
          "type": "number"
        },
        "entropy_nats": {
          "minimum": 0,
          "title": "Entropy Nats",
          "type": "number"
        },
        "concentration": {
          "maximum": 1,
          "minimum": 0,
          "title": "Concentration",
          "type": "number"
        },
        "unavailable_probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Unavailable Probability",
          "type": "number"
        }
      },
      "required": [
        "top_probability",
        "entropy_nats",
        "concentration",
        "unavailable_probability"
      ],
      "title": "Uncertainty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "model": {
      "additionalProperties": true,
      "title": "Model",
      "type": "object"
    },
    "mode": {
      "enum": [
        "shared",
        "direct"
      ],
      "title": "Mode",
      "type": "string"
    },
    "answers": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "boolean": "#/$defs/BooleanAnswer",
            "choice": "#/$defs/ChoiceAnswer",
            "numeric": "#/$defs/NumericAnswer",
            "score": "#/$defs/ScoreAnswer"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BooleanAnswer"
          },
          {
            "$ref": "#/$defs/ChoiceAnswer"
          },
          {
            "$ref": "#/$defs/ScoreAnswer"
          },
          {
            "$ref": "#/$defs/NumericAnswer"
          }
        ]
      },
      "title": "Answers",
      "type": "object"
    },
    "calibration": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Calibration"
    },
    "timing": {
      "$ref": "#/$defs/Timing"
    }
  },
  "required": [
    "model",
    "mode",
    "answers",
    "calibration",
    "timing"
  ],
  "title": "Response",
  "type": "object"
}

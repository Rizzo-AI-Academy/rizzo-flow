{
  "$defs": {
    "BooleanAnswer": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "insufficient_evidence",
            "out_of_range",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        },
        "probabilities": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        },
        "option_logits": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Option Logits",
          "type": "object"
        },
        "legend": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Legend",
          "type": "object"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "probability_status": {
          "enum": [
            "uncalibrated_conditional_option_scores",
            "temperature_scaled_requires_held_out_validation"
          ],
          "title": "Probability Status",
          "type": "string"
        },
        "temperature": {
          "exclusiveMinimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "input_tokens": {
          "exclusiveMinimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "type": {
          "const": "boolean",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "probability_true_given_available": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probability True Given Available"
        }
      },
      "required": [
        "status",
        "probabilities",
        "option_logits",
        "legend",
        "uncertainty",
        "probability_status",
        "temperature",
        "prompt_sha256",
        "input_tokens",
        "type",
        "value",
        "probability_true_given_available"
      ],
      "title": "BooleanAnswer",
      "type": "object"
    },

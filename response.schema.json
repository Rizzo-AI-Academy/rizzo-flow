          "type": "object"
        },
        "option_logits": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Option Logits",
          "type": "object"
        },
        "legend": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Legend",
          "type": "object"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "probability_status": {
          "enum": [
            "uncalibrated_conditional_option_scores",
            "temperature_scaled_requires_held_out_validation"
          ],
          "title": "Probability Status",
          "type": "string"
        },
        "temperature": {
          "exclusiveMinimum": 0,
          "title": "Temperature",

        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "input_tokens": {
          "exclusiveMinimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "type": {
          "const": "choice",
          "title": "Type",
          "type": "string"
        },
        "choice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"

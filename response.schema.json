        },
        "type": {
          "const": "score",
          "title": "Type",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "normalized_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized Score"
        },
        "statistics_given_available": {
          "anyOf": [
            {
              "$ref": "#/$defs/Statistics"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Values",

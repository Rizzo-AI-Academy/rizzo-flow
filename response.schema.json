        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "input_tokens": {
          "exclusiveMinimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "type": {
          "const": "numeric",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "statistics_given_available": {
          "anyOf": [
            {
              "$ref": "#/$defs/Statistics"
            },
            {
              "type": "null"
            }
          ]
        },
        "values": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Values",
          "type": "object"
        },
        "support": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Support",
          "type": "array"
        },
        "range_probabilities": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "below",
              "above"
            ]
          },
          "title": "Range Probabilities",
          "type": "object"
        }
      },
      "required": [
        "status",
        "probabilities",
        "option_logits",
        "legend",
        "uncertainty",
        "probability_status",
        "temperature",
        "prompt_sha256",
        "input_tokens",
        "type",
        "value",
        "unit",
        "statistics_given_available",
        "values",
        "support",
        "range_probabilities"
      ],
      "title": "NumericAnswer",
      "type": "object"
    },
    "ScoreAnswer": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "insufficient_evidence",
            "out_of_range",
            "uncertain"
          ],
          "title": "Status",
          "type": "string"
        },
        "probabilities": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        },
        "option_logits": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Option Logits",
          "type": "object"
        },
        "legend": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Legend",
          "type": "object"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "probability_status": {
          "enum": [
            "uncalibrated_conditional_option_scores",
            "temperature_scaled_requires_held_out_validation"
          ],
          "title": "Probability Status",
          "type": "string"
        },
        "temperature": {
          "exclusiveMinimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "input_tokens": {
          "exclusiveMinimum": 0,
          "title": "Input Tokens",
